@using System.Globalization
@using System.Text.Json
@using CrypTool.Web.Core
@using CrypWeb.App.Engine
@implements IHandleEvent
@inject HttpClient Http
@* Link manager (Home › Extras › Links): makes links that open a template with chosen settings (see TemplateLink) or a page of the documentation (see DocLink), and keeps them. *@
<div class="sm-back" @onclick="Close">
    <div class="sm-dialog wide lm" @onclick:stopPropagation @onkeydown="OnKey" tabindex="0">
        <div class="mhead lm-head" style="background:#3b5aa0">
            <div class="mtitle">@Loc["links.title"]<small>@Loc[docMode ? "links.introDoc" : "links.intro"]</small></div>
            <button class="mx lm-x" @onclick="Close" title="@Loc["view.close"]">✕</button>
        </div>
        <div class="mbody lm-body">
            <div class="lm-col lm-pick">
                <div class="lm-mode">
                    <button class="@(!docMode ? "on" : "")" @onclick="() => SetMode(false)">@Loc["links.modeTemplate"]</button>
                    <button class="@(docMode ? "on" : "")" @onclick="() => SetMode(true)">@Loc["links.modeDoc"]</button>
                </div>
                <div class="lm-h">1 · @Loc[docMode ? "links.docPage" : "links.template"]</div>
                <input class="lm-search" placeholder="@Loc["panel.search"]" @bind="search" @bind:event="oninput"/>
                @if (docMode)
                {
                    <div class="lm-tlist">
                        @if (docIndex == null)
                        {
                            <div class="mhint">@Loc[docFailed ? "docs.failed" : "docs.loading"]</div>
                        }
                        @foreach (var e in DocEntries.Take(300))
                        {
                            var ee = e;
                            <div class="lm-t @(ee.Target == docTarget ? "on" : "")" title="@ee.Target" @onclick="stable.Of(ee.Target, () => PickDoc(ee.Target))">
                                @if (ee.Icon != null)
                                {
                                    <img src="@ee.Icon"/>
                                }
                                <span>@ee.Title</span><small>@ee.Group</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="lm-tlist">
                        @foreach (var t in Templates.Where(t => search.Length == 0 || t.Contains(search, StringComparison.OrdinalIgnoreCase)).Take(300))
                        {
                            var tt = t;
                            <div class="lm-t @(tt == template ? "on" : "")" title="@tt" @onclick="stable.Of(tt, () => PickTemplate(tt))">
                                @if (Icons.Contains(tt))
                                {
                                    <img src="@IconOf(tt)"/>
                                }
                                <span>@Path.GetFileNameWithoutExtension(tt)</span><small>@(Path.GetDirectoryName(tt)?.Replace("/", " › "))</small>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="lm-col lm-edit">
                <div class="lm-h">2 · @Loc[docMode ? "links.docPreview" : "links.settings"]</div>
                @if (docMode)
                {
                    @if (CurrentDoc is { } d)
                    {
                        <div class="lm-docprev">
                            <b>@d.Title</b>
                            <small>@d.Group</small>
                            @if (d.Summary.Length > 0)
                            {
                                <p>@((MarkupString)d.Summary)</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mhint">@Loc["links.pickDocFirst"]</div>
                    }
                }
                else if (template == null)
                {
                    <div class="mhint">@Loc["links.pickFirst"]</div>
                }
                else if (loading)
                {
                    <div class="mhint">@Loc["links.loading"]</div>
                }
                else if (workspace == null)
                {
                    <div class="mhint err">@Loc["links.loadFailed"]</div>
                }
                else
                {
                    <div class="lm-comps">
                        @foreach (var p in workspace.Plugins.OrderBy(p => p.Y).ThenBy(p => p.X))
                        {
                            var pp = p;
                            var meta = MetaOf(pp);
                            var changedHere = overrides.Keys.Count(k => k.Id == pp.Id);
                            <div class="lm-comp @(expanded == pp.Id ? "open" : "")">
                                <div class="lm-ch" @onclick="stable.Of(pp, () => Toggle(pp))" style="border-left-color:@Theme.CategoryColor(meta?.Category ?? "Undefined")">
                                    @if (meta?.Icon != null)
                                    {
                                        <img src="@meta.Icon"/>
                                    }
                                    <span>@TitleOf(pp)</span>
                                    @if (changedHere > 0)
                                    {
                                        <i class="lm-badge">@changedHere</i>
                                    }
                                    <b>@(expanded == pp.Id ? "▾" : "▸")</b>
                                </div>
                                @if (expanded == pp.Id)
                                {
                                    <div class="lm-fields">
                                        @if (!fields.TryGetValue(pp.Id, out var list))
                                        {
                                            <div class="mhint">@Loc["links.loading"]</div>
                                        }
                                        else if (list.Count == 0)
                                        {
                                            <div class="mhint">@Loc["right.noSettings"]</div>
                                        }
                                        else
                                        {
                                            @foreach (var f in list)
                                            {
                                                var fld = f;
                                                var changed = overrides.ContainsKey((pp.Id, fld.Name));
                                                <div class="mrow @(changed ? "lm-changed" : "")" title="@fld.Tooltip">
                                                    <label class="mlabel">@fld.Caption</label>
                                                    <div class="mctl">@Field(pp, fld)</div>
                                                    @if (changed)
                                                    {
                                                        <button class="lm-reset" title="@Loc["links.reset"]" @onclick="stable.Of((pp, fld), () => Reset(pp, fld))">↺</button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="lm-col lm-out">
                <div class="lm-h">3 · @Loc["links.link"]</div>
                @if (!docMode)
                {
                    <label class="lm-opt"><input type="checkbox" @bind="run"/> @Loc["links.run"]</label>
                    <label class="lm-opt">@Loc["links.lang"]
                        <select @bind="lang">
                            <option value="">@Loc["links.langAny"]</option>
                            @foreach (var l in Localizer.Languages)
                            {
                                <option value="@l.Code">@l.Name</option>
                            }
                        </select>
                    </label>
                }
                <input class="lm-name" placeholder="@Loc["links.namePlaceholder"]" @bind="name" @bind:event="oninput"/>
                <textarea class="lm-url" readonly rows="4">@(Url ?? "")</textarea>
                <div class="lm-btns">
                    <button class="mdone" disabled="@(Url == null)" @onclick="Copy">@Loc[copied ? "links.copied" : "links.copy"]</button>
                    <button disabled="@(Url == null)" @onclick="Test" title="@Loc["links.testTip"]">@Loc["links.test"]</button>
                    <button disabled="@(Url == null)" @onclick="SaveLink">@Loc[editing != null ? "links.update" : "links.save"]</button>
                </div>
                @if (!docMode && overrides.Count > 0)
                {
                    <div class="lm-sum">@Loc.T("links.changedCount", overrides.Count)</div>
                }
                <div class="lm-h">@Loc["links.saved"]</div>
                @if (Links.Count == 0)
                {
                    <div class="mhint">@Loc["links.none"]</div>
                }
                <div class="lm-saved">
                    @foreach (var l in Links.ToList())
                    {
                        var ll = l;
                        <div class="lm-link @(ReferenceEquals(ll, editing) ? "on" : "")">
                            <div class="lm-ln" title="@ll.Url">@(DocLink.Parse(ll.Url) != null ? "📖 " : "")@ll.Name</div>
                            <div class="lm-la">
                                <button title="@Loc["links.copy"]" @onclick="stable.Of(ll, () => CopyUrl(ll.Url))">⧉</button>
                                <button title="@Loc["links.edit"]" @onclick="stable.Of(ll, () => Edit(ll))">✎</button>
                                <button title="@Loc["links.test"]" @onclick="stable.Of(ll, () => TestUrl(ll.Url))">▶</button>
                                <button class="red" title="@Loc["links.delete"]" @onclick="stable.Of(ll, () => Delete(ll))">✕</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly StableHandlers stable = new();

    [Parameter][EditorRequired] public IEnumerable<string> Templates { get; set; } = default!;
    [Parameter] public HashSet<string> Icons { get; set; } = new();
    [Parameter][EditorRequired] public Localizer Loc { get; set; } = default!;
    [Parameter][EditorRequired] public Func<string, Task<Workspace?>> LoadTemplate { get; set; } = default!;
    [Parameter][EditorRequired] public Func<PluginNode, PluginMeta?> MetaOf { get; set; } = default!;
    [Parameter][EditorRequired] public Func<PluginNode, string> TitleOf { get; set; } = default!;
    [Parameter][EditorRequired] public List<SavedLink> Links { get; set; } = default!;
    [Parameter] public string BaseUri { get; set; } = "";
    [Parameter] public EventCallback OnLinksChanged { get; set; }
    [Parameter] public EventCallback<TemplateLink> OnTest { get; set; }

    /// <summary>Opens a documentation page ("component/&lt;type&gt;", ...) in the documentation tab.</summary>
    [Parameter] public EventCallback<string> OnTestDoc { get; set; }

    [Parameter] public bool ShowExperimental { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private static CultureInfo Inv { get; } = CultureInfo.InvariantCulture;

    // The page re-renders many times a second while the engine reports (also when idle), and passes this dialog new
    // parameters each time. A re-render gives the handlers in the lists new ids, and a click that arrives in between is
    // lost (see Pages/Home.Handlers.cs). So the dialog draws itself only after its own events and changes.
    private bool renderRequested = true;

    protected override bool ShouldRender()
    {
        var render = renderRequested;
        renderRequested = false;
        return render;
    }

    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        await callback.InvokeAsync(arg);
        Redraw();
    }

    private void Redraw()
    {
        renderRequested = true;
        StateHasChanged();
    }
    private string search = "";
    private string? template;
    private bool docMode;
    private string? docTarget;
    private DocsIndex? docIndex;
    private bool docFailed;
    private Workspace? workspace;
    private bool loading;
    private int? expanded;
    private bool run;
    private string lang = "";
    private string name = "";
    private bool copied;
    private SavedLink? editing;

    /// <summary>The settings form of each component (as in the settings dialog), with the template's values.</summary>
    private readonly Dictionary<int, List<SettingField>> fields = new();

    /// <summary>The values chosen here that differ from the template: (component id, setting) -> value.</summary>
    private readonly Dictionary<(int Id, string Setting), string> overrides = new();

    private static string IconOf(string t) => "templates/" + Uri.EscapeDataString(t[..^4]).Replace("%2F", "/") + ".png";

    private string? Url => docMode
        ? (docTarget == null ? null : BaseUri + DocLink.Href(DocLink.Split(docTarget).Kind, DocLink.Split(docTarget).Id).Replace("%2F", "/"))
        : template == null ? null : BuildLink().ToUrl(BaseUri);

    // ---- documentation links ----

    private sealed record DocEntry(string Target, string Title, string Group, string? Icon, string Summary);

    private IEnumerable<DocEntry> AllDocs()
    {
        if (docIndex == null) yield break;
        var lang = Loc.Lang;
        foreach (var a in docIndex.Articles)
            yield return new DocEntry("article/" + a.Id, DocsText.Pick(a.Title, lang), Loc["docs.articles"], null, "");
        foreach (var c in docIndex.Components.Where(c => c.Article && (ShowExperimental || !c.Experimental)))
            yield return new DocEntry("component/" + c.Id, c.NameFor(lang), Loc["panel.components"] + " › " + Loc["cat." + c.Category], c.Icon, c.TooltipFor(lang));
        foreach (var t in docIndex.Templates.Where(t => ShowExperimental || !t.Experimental))
        {
            var title = DocsText.Pick(t.Title, lang);
            yield return new DocEntry("template/" + t.Id, title.Length > 0 ? title : Path.GetFileNameWithoutExtension(t.Id),
                Loc["panel.templates"] + " › " + t.Folder.Replace("/", " › "), null, DocsText.Pick(t.Summary, lang));
        }
    }

    private IEnumerable<DocEntry> DocEntries =>
        AllDocs().Where(e => search.Length == 0 || e.Title.Contains(search, StringComparison.OrdinalIgnoreCase) || e.Target.Contains(search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(e => e.Group.StartsWith(Loc["docs.articles"]) ? 0 : 1).ThenBy(e => e.Group, StringComparer.CurrentCultureIgnoreCase).ThenBy(e => e.Title, StringComparer.CurrentCultureIgnoreCase);

    private DocEntry? CurrentDoc => docTarget == null ? null : AllDocs().FirstOrDefault(e => e.Target == docTarget);

    private async Task SetMode(bool doc)
    {
        if (docMode == doc) return;
        docMode = doc;
        search = "";
        copied = false;
        editing = null;
        if (doc) await LoadDocIndex();
    }

    private async Task LoadDocIndex()
    {
        if (docIndex != null) return;
        docFailed = false;
        Redraw();
        try
        {
            docIndex = await Http.GetFromJsonAsync<DocsIndex>("docs/index.json");
        }
        catch (Exception)
        {
            docFailed = true;
        }
    }

    private void PickDoc(string target)
    {
        docTarget = target;
        copied = false;
        if (editing == null || DocLink.Parse(editing.Url) == null) editing = null;
        name = CurrentDoc?.Title ?? target;
    }

    private TemplateLink BuildLink()
    {
        var link = new TemplateLink { Template = template!, Run = run, Lang = lang.Length == 0 ? null : lang };
        foreach (var plugin in workspace?.Plugins.OrderBy(p => p.Id) ?? Enumerable.Empty<PluginNode>())
        {
            foreach (var (key, value) in overrides.Where(o => o.Key.Id == plugin.Id).OrderBy(o => o.Key.Setting))
                link.Settings.Add((plugin.Id.ToString(Inv), key.Setting, value));
        }

        return link;
    }

    private async Task PickTemplate(string t, TemplateLink? from = null)
    {
        if (t == template && from == null) return;
        template = t;
        workspace = null;
        fields.Clear();
        overrides.Clear();
        expanded = null;
        copied = false;
        if (from == null)
        {
            editing = null;
            name = Path.GetFileNameWithoutExtension(t);
        }

        loading = true;
        Redraw();
        workspace = await LoadTemplate(t);
        loading = false;
        if (workspace != null && from != null)
        {
            foreach (var (component, setting, value) in from.Settings)
            {
                if (Pages.Home.LinkTarget(workspace, component) is { } plugin) overrides[(plugin.Id, setting)] = value;
            }
        }
        // the component with the most to set (usually the cipher) is shown first
        var first = workspace?.Plugins.FirstOrDefault(p => overrides.Keys.Any(k => k.Id == p.Id))
                    ?? workspace?.Plugins.Where(p => NativeKind(p) == null).OrderBy(p => p.Y).ThenBy(p => p.X).FirstOrDefault();
        if (first != null) await Toggle(first);
    }

    private async Task Toggle(PluginNode p)
    {
        expanded = expanded == p.Id ? null : p.Id;
        if (expanded == null || fields.ContainsKey(p.Id)) return;
        Redraw();
        await Task.Yield();
        fields[p.Id] = LoadFields(p);
        Redraw();
    }

    /// <summary>Browser-native in-/outputs: the value they hold is their only setting (see NativeComponent).</summary>
    private static NativeComponent.Kind? NativeKind(PluginNode p) => NativeComponent.TryCreate(p.TypeName)?.Which;

    private List<SettingField> LoadFields(PluginNode p)
    {
        switch (NativeKind(p))
        {
            case NativeComponent.Kind.TextInput:
                return new List<SettingField> { new() { Name = "Text", Caption = Loc["links.text"], Control = "TextArea", ValueType = "string", TypeName = "System.String", Value = p.Settings.GetValueOrDefault("Text", "") } };
            case NativeComponent.Kind.NumberInput:
                return new List<SettingField> { new() { Name = "Number", Caption = Loc["links.number"], Control = "TextBox", ValueType = "string", TypeName = "System.String", Value = p.Settings.GetValueOrDefault("Number", "") } };
            case NativeComponent.Kind.BooleanInput:
                return new List<SettingField> { new() { Name = "Value", Caption = Loc["links.value"], Control = "TextBox", ValueType = "int", TypeName = "System.Int32", Value = p.Settings.GetValueOrDefault("Value", "0") } };
            case not null:
                return new List<SettingField>(); // outputs have nothing to set
        }

        try
        {
            using var doc = JsonDocument.Parse(EngineHost.Schema(p.TypeName, JsonSerializer.Serialize(p.Settings)));
            if (!doc.RootElement.TryGetProperty("fields", out var list)) return new List<SettingField>();
            var all = JsonSerializer.Deserialize<List<SettingField>>(list.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<SettingField>();
            // actions, files and read-only values cannot be given in a link
            return all.Where(f => f.Control is not ("Button" or "OpenFileDialog" or "SaveFileDialog" or "TextBoxReadOnly")).ToList();
        }
        catch (Exception)
        {
            return new List<SettingField>();
        }
    }

    private string Cur(PluginNode p, SettingField f) => overrides.TryGetValue((p.Id, f.Name), out var v) ? v : f.Value;

    private void Set(PluginNode p, SettingField f, string value)
    {
        copied = false;
        if (value == f.Value) overrides.Remove((p.Id, f.Name));
        else overrides[(p.Id, f.Name)] = value;
    }

    private void SetBool(PluginNode p, SettingField f, object? value) => Set(p, f, value is true ? "True" : "False");

    private void Reset(PluginNode p, SettingField f)
    {
        overrides.Remove((p.Id, f.Name));
        copied = false;
    }

    private RenderFragment Field(PluginNode p, SettingField f) => __builder =>
    {
        var value = Cur(p, f);
        switch (f.Control)
        {
            case "ComboBox" or "DynamicComboBox" or "LanguageSelector" or "RadioButton":
                <select @onchange="stable.Of((p, f), (ChangeEventArgs e) => Set(p, f, e.Value?.ToString() ?? string.Empty))">
                    @for (var i = 0; i < f.Options.Count; i++)
                    {
                        var idx = i.ToString(Inv);
                        <option value="@idx" selected="@(value == idx)">@f.Options[i]</option>
                    }
                </select>
                break;
            case "CheckBox":
                <input type="checkbox" checked="@(value == "True")" @onchange="stable.Of((p, f), (ChangeEventArgs e) => SetBool(p, f, e.Value))"/>
                break;
            case "TextArea":
                <textarea rows="4" spellcheck="false" value="@value" @onchange="stable.Of((p, f), (ChangeEventArgs e) => Set(p, f, e.Value?.ToString() ?? string.Empty))"></textarea>
                break;
            case "NumericUpDown" or "Slider":
                var step = (f.Step ?? (f.ValueType == "int" ? 1 : 0.1)).ToString(Inv);
                <input type="number" min="@(f.Min?.ToString(Inv))" max="@(f.Max?.ToString(Inv))" step="@step"
                       value="@value" @onchange="stable.Of((p, f), (ChangeEventArgs e) => Set(p, f, e.Value?.ToString() ?? string.Empty))"/>
                break;
            default:
                <input type="@(f.ValueType is "int" or "double" ? "number" : "text")" value="@value"
                       @onchange="stable.Of((p, f), (ChangeEventArgs e) => Set(p, f, e.Value?.ToString() ?? string.Empty))"/>
                break;
        }
    };

    private async Task Copy()
    {
        if (Url is { } url) copied = await Js.InvokeAsync<bool>("ct2.copyText", url);
    }

    private async Task CopyUrl(string url) => await Js.InvokeAsync<bool>("ct2.copyText", url);

    private async Task Test()
    {
        if (docMode && docTarget != null) await OnTestDoc.InvokeAsync(docTarget);
        else await OnTest.InvokeAsync(BuildLink());
    }

    private async Task TestUrl(string url)
    {
        if (DocLink.Parse(url) is { } target) await OnTestDoc.InvokeAsync(target);
        else if (TemplateLink.Parse(url) is { } link) await OnTest.InvokeAsync(link);
    }

    private async Task SaveLink()
    {
        if (Url is not { } url) return;
        var title = name.Trim().Length > 0 ? name.Trim() : docMode ? docTarget! : Path.GetFileNameWithoutExtension(template!);
        if (editing != null && Links.Contains(editing))
        {
            editing.Name = title;
            editing.Url = url;
        }
        else
        {
            editing = new SavedLink { Name = title, Url = url };
            Links.Insert(0, editing);
        }

        await OnLinksChanged.InvokeAsync();
    }

    private async Task Edit(SavedLink l)
    {
        if (DocLink.Parse(l.Url) is { } target)
        {
            docMode = true;
            search = "";
            await LoadDocIndex();
            editing = l;
            docTarget = target;
            name = l.Name;
            copied = false;
            return;
        }

        docMode = false;
        if (TemplateLink.Parse(l.Url) is not { } link) return;
        editing = l;
        name = l.Name;
        run = link.Run;
        lang = link.Lang ?? "";
        template = null; // load again, with the link's values
        await PickTemplate(link.Template, link);
    }

    private async Task Delete(SavedLink l)
    {
        Links.Remove(l);
        if (ReferenceEquals(editing, l)) editing = null;
        await OnLinksChanged.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
