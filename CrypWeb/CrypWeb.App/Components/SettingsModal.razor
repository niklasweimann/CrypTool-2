@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using CrypTool.Web.Core
@using CrypWeb.App.Engine
<div class="sm-back" @onclick="Close">
    <div class="sm-dialog" @onclick:stopPropagation @onkeydown="OnKey" tabindex="0">
        <div class="mhead" style="background:@HeadColor">
            @if (Meta?.Icon != null)
            {
                <img src="@Meta.Icon"/>
            }
            <div class="mtitle">@Title<small>@Meta?.Tooltip</small></div>
            <button class="mx" @onclick="Close" title="Close">✕</button>
        </div>
        <div class="mbody">
            @if (Loading)
            {
                <div class="mhint">Loading settings…</div>
            }
            else if (Error != null)
            {
                <div class="mhint err">@Error</div>
            }
            else if (Fields.Count == 0)
            {
                <div class="mhint">This component has no settings.</div>
            }
            else
            {
                @foreach (var grp in Fields.GroupBy(f => f.Group))
                {
                    @if (grp.Key != "")
                    {
                        <div class="mgroup">@grp.Key</div>
                    }

                    @foreach (var f in grp)
                    {
                        var fld = f;
                        <div class="mrow" title="@fld.Tooltip">
                            <label class="mlabel">@fld.Caption</label>
                            <div class="mctl">
                                @switch (fld.Control)
                                {
                                    case "ComboBox" or "DynamicComboBox" or "LanguageSelector":
                                        <select value="@Cur(fld)"
                                                @onchange="Change(fld)">
                                            @for (var i = 0; i < fld.Options.Count; i++)
                                            {
                                                var idx = i;
                                                <option value="@idx"
                                                        selected="@(Cur(fld) == idx.ToString())">@fld.Options[idx]</option>
                                            }
                                        </select>
                                        break;
                                    case "RadioButton":
                                        <div class="mradios">
                                            @for (var i = 0; i < fld.Options.Count; i++)
                                            {
                                                var idx = i;
                                                <label><input
                                                        type="radio"
                                                        name="@fld.Name"
                                                        checked="@(Cur(fld) == idx.ToString())"
                                                        @onchange="Pick(fld, idx)"/> @fld.Options[idx]
                                                </label>
                                            }
                                        </div>
                                        break;
                                    case "CheckBox":
                                        <input type="checkbox" checked="@(Cur(fld) == "True")"
                                               @onchange="Toggle(fld)"/>
                                        break;
                                    case "Slider":
                                        <div class="mslider"><input
                                                type="range"
                                                min="@Num(fld.Min, 0)"
                                                max="@Num(fld.Max, 100)"
                                                step="@Num(fld.Step, 1)"
                                                value="@Cur(fld)"
                                                @oninput="Change(fld)"/><span>@Cur(fld)</span>
                                        </div>
                                        break;
                                    case "NumericUpDown":
                                        <input
                                            class="@(Problem(fld) != null ? "bad" : "")"
                                            type="number"
                                            min="@(fld.Min?.ToString(Inv))"
                                            max="@(fld.Max?.ToString(Inv))"
                                            step="@Num(fld.Step, fld.ValueType == "int" ? 1 : 0.1)"
                                            value="@Cur(fld)"
                                            @onchange="Change(fld)"/>
                                        break;
                                    case "TextBoxReadOnly":
                                        <input readonly value="@Cur(fld)"/>
                                        break;
                                    case "TextBoxHidden":
                                        <input type="password" value="@Cur(fld)"
                                               @onchange="Change(fld)"/>
                                        break;
                                    case "OpenFileDialog" or "SaveFileDialog":
                                        <input value="@Cur(fld)" disabled/>
                                        <span class="mnote">File access is not available in the browser yet.</span>
                                        break;
                                    case "Button":
                                        <button disabled>@fld.Caption</button>
                                        <span class="mnote">Actions are not available in the browser yet.</span>
                                        break;
                                    default:
                                        <input
                                            class="@(Invalid(fld) ? "bad" : "")"
                                            type="@(fld.ValueType is "int" or "double" ? "number" : "text")"
                                            value="@Cur(fld)"
                                            @onchange="Change(fld)"/>
                                        break;
                                }
                                @if (Problem(fld) is { } problem)
                                {
                                    <span class="mnote err">@problem</span>
                                }
                            </div>
                        </div>
                    }
                }
            }
        </div>
        <div
            class="mfoot">@(Running ? "Changes apply immediately only to settings that may change while the workspace is running." : "")<button
                class="mdone" @onclick="Close">Done
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter][EditorRequired] public PluginNode Node { get; set; } = default!;
    [Parameter] public PluginMeta? Meta { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Running { get; set; }
    [Parameter] public EventCallback<(string Name, string Value, string Type)> OnChange { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static CultureInfo Inv { get; } = CultureInfo.InvariantCulture;
    private List<SettingField> Fields { get; set; } = new();
    readonly Dictionary<string, string> cur = new();
    private bool Loading { get; set; } = true;
    private string? Error { get; set; }
    private int LoadedFor { get; set; } = -1;
    string HeadColor => Theme.CategoryColor(Meta?.Category ?? "Undefined");

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedFor == Node.Id)
        {
            return;
        }

        LoadedFor = Node.Id;
        Loading = true;
        Error = null;
        Fields = new List<SettingField>();
        cur.Clear();
        problems.Clear();
        handlers.Clear();
        try
        {
            // computed in the app; yields first so the dialog shows its "loading" state
            await Task.Yield();
            var json = EngineHost.Schema(Node.TypeName, JsonSerializer.Serialize(Node.Settings));
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("error", out var err))
            {
                Error = err.GetString();
            }
            else
            {
                var fieldsJson = doc.RootElement.GetProperty("fields").GetRawText();
                Fields = JsonSerializer.Deserialize<List<SettingField>>(fieldsJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<SettingField>();
            }

            foreach (var field in Fields) cur[field.Name] = field.Value;
        }
        catch (Exception e)
        {
            Error = "Could not load settings: " + e.Message;
        }

        Loading = false;
    }

    string Cur(SettingField f)
    {
        return cur.GetValueOrDefault(f.Name, f.Value);
    }

    static string Num(double? v, double dflt)
    {
        return (v ?? dflt).ToString(Inv);
    }

    /// <summary>True when the field has a validation pattern and the current text does not match it.</summary>
    bool Invalid(SettingField f)
    {
        if (f.Regex == null) return false;
        try
        {
            return !Regex.IsMatch(Cur(f), f.Regex);
        }
        catch (ArgumentException)
        {
            return false;
        } // the pattern itself is invalid: do not block input
    }

    // Event handlers of the fields. Blazor gives a handler a new id whenever its delegate changes; a lambda created in the
    // render loop is a new delegate on every render, and an event that arrives while the DOM is being updated is then lost
    // ("There is no event handler associated with this event"). One delegate per field and kind keeps the id stable.
    readonly Dictionary<string, Delegate> handlers = new();
    readonly Dictionary<string, string> problems = new();

    T Cached<T>(string key, Func<T> create) where T : Delegate
    {
        if (handlers.TryGetValue(key, out var existing)) return (T)existing;
        var made = create();
        handlers[key] = made;
        return made;
    }

    Func<ChangeEventArgs, Task> Change(SettingField f) =>
        Cached("c:" + f.Name, () => (Func<ChangeEventArgs, Task>)(e => Set(f, e.Value?.ToString() ?? string.Empty)));

    Func<ChangeEventArgs, Task> Toggle(SettingField f) =>
        Cached("t:" + f.Name, () => (Func<ChangeEventArgs, Task>)(e => Set(f, e.Value is true ? "True" : "False")));

    Func<ChangeEventArgs, Task> Pick(SettingField f, int index) =>
        Cached("p:" + f.Name + ":" + index, () => (Func<ChangeEventArgs, Task>)(_ => Set(f, index.ToString())));

    string? Problem(SettingField f)
    {
        return problems.GetValueOrDefault(f.Name);
    }

    /// <summary>
    ///     Checks a number against the type and the range of the setting. Returns the value to store (a number outside the range
    ///     is brought back into it), or null with a message when the text is not a number of the type.
    /// </summary>
    string? Validate(SettingField f, string v, out string? message)
    {
        message = null;
        var isInt = f.ValueType == "int";
        if (!isInt && f.ValueType != "double") return v;
        if (!double.TryParse(v, NumberStyles.Float, Inv, out var n) || double.IsNaN(n) || double.IsInfinity(n))
        {
            message = "Please enter a number.";
            return null;
        }

        if (isInt && n != Math.Floor(n))
        {
            message = "Please enter a whole number.";
            return null;
        }

        // a range of 0..0 means "not specified"
        var ranged = f.Min is { } lo && f.Max is { } hi && hi > lo;
        var min = ranged ? f.Min!.Value : isInt ? int.MinValue : double.MinValue;
        var max = ranged ? f.Max!.Value : isInt ? int.MaxValue : double.MaxValue;
        if (n < min || n > max)
        {
            n = Math.Clamp(n, min, max);
            message = $"Out of range, set to {n.ToString(Inv)}.";
        }

        return n.ToString(Inv);
    }

    async Task Set(SettingField f, string v)
    {
        var valid = Validate(f, v, out var message);
        if (message == null) problems.Remove(f.Name);
        else problems[f.Name] = message;
        if (valid == null) { cur[f.Name] = v; return; } // not a number: keep the typed text, do not apply it
        v = valid;
        cur[f.Name] = v;
        if (Invalid(f)) return;
        await OnChange.InvokeAsync((f.Name, v, f.TypeName));
    }

    Task Close()
    {
        return OnClose.InvokeAsync();
    }

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }

}
