@* Line icons on a 24x24 grid for the ribbon, tabs and canvas tools. They take their color from the CSS "color". *@
<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size"
     fill="@(Filled ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.7"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="@PathOf(Name)"/>
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 26;

    private bool Filled => Name is "play" or "stop";

