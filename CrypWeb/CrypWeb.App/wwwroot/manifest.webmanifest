{
  "name": "CrypTool 2 Web Edition",
  "short_name": "CrypTool 2",
  "description": "Cryptography and cryptanalysis workspaces of CrypTool 2 in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e8eef9",
  "theme_color": "#2b3f6b",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/octet-stream": [".cwm"]}}
  ]
}
