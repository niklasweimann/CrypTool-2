@namespace CrypTool.Web.App.Visualizers
@inherits VizBase
@attribute [Visualizer("NLFSR")]
@{
  var state = (Get("FillBoxes") is { ValueKind: System.Text.Json.JsonValueKind.Array } f && f.GetArrayLength() > 0 ? f[0] : Get("DrawNLFSR") is { ValueKind: System.Text.Json.JsonValueKind.Array } d && d.GetArrayLength() > 0 ? d[0] : (System.Text.Json.JsonElement?)null);
  var taps = (Get("FillBoxes") is { ValueKind: System.Text.Json.JsonValueKind.Array } f2 && f2.GetArrayLength() > 1 ? f2[1] : Get("DrawNLFSR") is { ValueKind: System.Text.Json.JsonValueKind.Array } d2 && d2.GetArrayLength() > 1 ? d2[1] : (System.Text.Json.JsonElement?)null);
  var bits = state is { ValueKind: System.Text.Json.JsonValueKind.Array } s ? s.EnumerateArray().Select(Str).ToList() : new List<string>();
  var tapList = taps is { ValueKind: System.Text.Json.JsonValueKind.Array } t ? t.EnumerateArray().Select(Str).ToList() : new List<string>();
  var fill = Get("FillBoxes") is { ValueKind: System.Text.Json.JsonValueKind.Array } f3 ? f3.EnumerateArray().Select(Str).ToList() : new List<string>();
}
@if (bits.Count == 0) { <div class="mhint">…</div> }
else
{
  <div class="reg">
    @for (int i = 0; i < bits.Count; i++)
    {
      <div class="reg-b @(bits[i] == "1" ? "on" : "") @(i < tapList.Count && tapList[i] == "1" ? "tap" : "")"><span>@bits[i]</span><small>@i</small></div>
    }
  </div>
  @if (fill.Count >= 5) { <div class="vsmall">output bit @fill[2] · input bit @fill[3] · polynomial @fill[4]</div> }
  <div class="vsmall">highlighted border = tap positions</div>
}
