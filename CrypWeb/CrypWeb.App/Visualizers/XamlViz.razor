@namespace CrypTool.Web.App.Visualizers
@inherits VizBase
@using System.Xml.Linq
@using System.Text.Json
@inject HttpClient Http
@inject Localizer Loc
@inject IJSRuntime JS
@* Generic visualization: the plugin's original presentation XAML drawn by XamlRenderer, plus state from the recorded presentation calls. *@
@if (files.Count > 1)
{
  <div class="tabs">@for (int i = 0; i < files.Count; i++) { var k = i; <button class="@(k == cur ? "on" : "")" @onclick="() => Pick(k)">@System.IO.Path.GetFileNameWithoutExtension(files[k]).Replace("Presentation", "")</button> }</div>
}
@if (html == null) { <div class="mhint">…</div> }
else { <div class="xamlhost @(Inline ? "inline" : "")" @ref="host">@((MarkupString)html)</div> }

@code {
  ElementReference host;
  static JsonElement? index;
  string folder = ""; List<string> files = new(); int cur; string? html; HashSet<string> images = new(); Dictionary<string, string> res = new();
  string? loadedFor; string? loadedPres;

  protected override async Task OnParametersSetAsync()
  {
    var key = TypeName + "|" + Loc.Lang;
    if (loadedFor != key)
    {
      loadedFor = key; loadedPres = null; html = null;
      index ??= JsonDocument.Parse(await Http.GetStringAsync("xaml/index.json")).RootElement.Clone();
      folder = XamlRegistry.Folder(TypeName, index.Value) ?? "";
      if (folder == "") return;
      var ent = index.Value.GetProperty(folder);
      files = ent.GetProperty("files").EnumerateArray().Select(x => x.GetString()!).OrderBy(f => f.Contains("Frame") || f.Contains("Container") ? 1 : 0).ThenBy(f => f.Length).ToList();
      images = ent.GetProperty("images").EnumerateArray().Select(x => x.GetString()!).ToHashSet();
      res = new(); var r = ent.GetProperty("res");
      foreach (var lang in new[] { "en", Loc.Lang }) if (r.TryGetProperty(lang, out var o)) foreach (var p in o.EnumerateObject()) res[p.Name] = p.Value.GetString() ?? "";
      cur = 0;
    }
    var sig = string.Join("\u0001", Pres.OrderBy(p => p.Key).Select(p => p.Key + "\u0002" + p.Value)) + cur;
    if (folder != "" && sig != loadedPres) { loadedPres = sig; await Draw(); }
  }

  async Task Pick(int i) { cur = i; loadedPres = null; await Draw(); }

  async Task Draw()
  {
    if (files.Count == 0) return;
    var file = files[cur];
    var xml = await Http.GetStringAsync($"xaml/{folder}/{file}");
    var dir = file.Contains('/') ? file[..file.LastIndexOf('/')] + "/" : "";
    var r = new XamlRenderer
    {
      Res = res,
      ImageUrl = s =>
      {
        s = System.Text.RegularExpressions.Regex.Replace(s, @"^(pack://application:,,,)?/[^;/]*;component/", "").TrimStart('/');
        foreach (var c in new[] { dir + s, s }) { var hit = images.FirstOrDefault(i => string.Equals(i, c, StringComparison.OrdinalIgnoreCase)); if (hit != null) return $"xaml/{folder}/{hit}"; }
        return null;
      },
    };
    XamlAdapters.Apply(TypeName, files[cur], r, this);
    html = r.Render(XDocument.Parse(xml).Root!);
    fitSize = r.RootSize;
    StateHasChanged();
    await Task.Yield();
    try { await JS.InvokeVoidAsync("ctXamlFit", host); } catch { }
  }
  (double w, double h)? fitSize;
  protected override async Task OnAfterRenderAsync(bool first) { if (html != null) try { await JS.InvokeVoidAsync("ctXamlFit", host); } catch { } }

  public IEnumerable<KeyValuePair<string, string>> AllCalls => Pres;
  public JsonElement? Call(string n) => Get(n);
  public static string S(JsonElement e) => Str(e);
}
