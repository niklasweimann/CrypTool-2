@namespace CrypTool.Web.App.Visualizers
@inherits VizBase
@attribute [Visualizer("StraddlingCheckerboard", "SyllabaryCipher")]
@* Plugins that hand a table (or DataTable) to their presentation: shown as a grid, with row headers when given. *@
@{
  var call = Get("ShowCheckerboard") ?? Get("FillTable");
  var head = new List<string>(); var rows = new List<List<string>>(); var rowHeads = new List<string>(); string key = "";
  if (call is { ValueKind: System.Text.Json.JsonValueKind.Array } a && a.GetArrayLength() > 0)
  {
    var first = a[0];
    if (first.ValueKind == System.Text.Json.JsonValueKind.Object && first.TryGetProperty("rows", out var r))
    {
      head = first.GetProperty("columns").EnumerateArray().Select(Str).ToList();
      rows = r.EnumerateArray().Select(x => x.EnumerateArray().Select(Str).ToList()).ToList();
      if (a.GetArrayLength() > 1 && a[1].ValueKind == System.Text.Json.JsonValueKind.Array) rowHeads = a[1].EnumerateArray().Select(Str).ToList();
    }
    else if (first.ValueKind == System.Text.Json.JsonValueKind.String && a.GetArrayLength() > 1 && a[1].ValueKind == System.Text.Json.JsonValueKind.Array)
    {
      key = Str(first);
      rows = a[1].EnumerateArray().Select(x => x.EnumerateArray().Select(Str).ToList()).ToList();
    }
  }
}
@if (rows.Count == 0) { <div class="mhint">…</div> }
else
{
  @if (key != "") { <div class="vsmall">Key: <span class="mono">@key</span></div> }
  <div class="vgrid board @(Inline ? "inline" : "")"><table>
    @if (head.Count > 0) { <tr>@if (rowHeads.Count > 0) { <th></th> }@foreach (var h in head) { <th>@h</th> }</tr> }
    @for (int i = 0; i < rows.Count; i++)
    {
      <tr>@if (rowHeads.Count > 0) { <th>@(i < rowHeads.Count ? rowHeads[i] : "")</th> }@foreach (var c in rows[i]) { <td class="@(rowHeads.Count > 0 && c == "" ? "blk" : "")">@c</td> }</tr>
    }
  </table></div>
}
