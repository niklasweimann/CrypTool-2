@namespace CrypTool.Web.App.Visualizers
@inherits VizBase
@attribute [Visualizer("Huffman")]
@{
  var table = Get("fillCodeTable");
  var codes = new List<(string ch, string bits)>();
  if (table is { ValueKind: System.Text.Json.JsonValueKind.Array } a && a.GetArrayLength() > 0 && a[0].ValueKind == System.Text.Json.JsonValueKind.Object)
    foreach (var p in a[0].EnumerateObject()) codes.Add((p.Name, string.Concat(p.Value.EnumerateArray().Select(b => b.ValueKind == System.Text.Json.JsonValueKind.True ? "1" : "0"))));
  var hist = table is { ValueKind: System.Text.Json.JsonValueKind.Array } a2 && a2.GetArrayLength() > 1 && a2[1].ValueKind == System.Text.Json.JsonValueKind.Object ? a2[1] : (System.Text.Json.JsonElement?)null;
  var sizes = table is { ValueKind: System.Text.Json.JsonValueKind.Array } a3 && a3.GetArrayLength() > 3 ? (a3[2].ToString(), a3[3].ToString()) : ("", "");
}
@if (codes.Count == 0) { <div class="mhint">…</div> }
else
{
  <table class="vtab">
    <tr><th>Character</th><th>Frequency</th><th>Code</th></tr>
    @foreach (var (ch, bits) in codes.OrderByDescending(c => hist is { } h && h.TryGetProperty(c.ch, out var f) ? f.GetDouble() : 0).ThenBy(c => c.bits.Length))
    {
      <tr><td class="mono">@(ch == " " ? "␣" : ch)</td><td>@(hist is { } h2 && h2.TryGetProperty(ch, out var fr) ? fr.ToString() : "")</td><td class="mono">@bits</td></tr>
    }
  </table>
  @if (sizes.Item1 != "") { <div class="vsmall">uncompressed @sizes.Item1 bytes → compressed @sizes.Item2 bytes</div> }
}
