@namespace CrypTool.Web.App.Visualizers
@inherits VizBase
@attribute [Visualizer("JosseCipher")]
@* Original: TabControl with the replacement rectangle (no headers) and the character mapping table (column headers). *@
@{
  Tbl(Get("BuildRectangleTable"), out var rh, out var rr);
  Tbl(Get("BuildCharacterMappingTable"), out var ch, out var cr);
}
<div class="tabs">
  <button class="@(tab == 0 ? "on" : "")" @onclick="() => tab = 0">Replacement</button>
  <button class="@(tab == 1 ? "on" : "")" @onclick="() => tab = 1">Character mapping</button>
</div>
<div class="vgrid"><table>
  @if (tab == 0) { @foreach (var r in rr) { <tr>@foreach (var c in r) { <td>@c</td> }</tr> } }
  else { <tr>@foreach (var h in ch) { <th>@h</th> }</tr>@foreach (var r in cr) { <tr>@foreach (var c in r) { <td>@c</td> }</tr> } }
</table></div>
@code {
  int tab;
  void Tbl(System.Text.Json.JsonElement? e, out List<string> head, out List<List<string>> rows)
  {
    head = new(); rows = new();
    if (e is { ValueKind: System.Text.Json.JsonValueKind.Object } o && o.TryGetProperty("rows", out var r))
    {
      head = o.GetProperty("columns").EnumerateArray().Select(Str).ToList();
      rows = r.EnumerateArray().Select(x => x.EnumerateArray().Select(Str).ToList()).ToList();
    }
  }
}
