<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- the engine runs in the app: plugin code on background threads (needs cross-origin isolation, see README) -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- some plugins keep pictures in their Resources.resx (Keccak, PKCS1); Blazor turns such resource types off,
         and then every string lookup in that file fails ({Loc Key} would show the key) -->
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrypWeb.Core\CrypWeb.Core.csproj"/>
    <ProjectReference Include="..\CrypWeb.Plugins\CrypWeb.Plugins.csproj"/>
  </ItemGroup>
  <Import Project="..\CrypWeb.Plugins\isolated.g.props"/>

  <!-- The git commit of the build, shown next to "Prototype" in the ribbon (BuildInfo.GitHash).
       Without git (source archive) the build still works and the version shows "dev". -->
  <Target Name="StampGitHash" BeforeTargets="GetAssemblyAttributes;CoreGenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low"
          StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="CrypWebGitHash"/>
      <Output TaskParameter="ExitCode" PropertyName="CrypWebGitExit"/>
    </Exec>
    <PropertyGroup>
      <CrypWebGitHash Condition="'$(CrypWebGitExit)' != '0' Or '$(CrypWebGitHash)' == ''">dev</CrypWebGitHash>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitHash</_Parameter1>
        <_Parameter2>$(CrypWebGitHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
