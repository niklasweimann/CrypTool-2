<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- the engine runs in the app: plugin code on background threads (needs cross-origin isolation, see README) -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrypWeb.Core\CrypWeb.Core.csproj" />
    <ProjectReference Include="..\CrypWeb.Plugins\CrypWeb.Plugins.csproj" />
  </ItemGroup>
  <Import Project="..\CrypWeb.Plugins\isolated.g.props" />

</Project>
