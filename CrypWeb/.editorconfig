# Code style for CrypWeb (hand-written code only; generated *.g.cs files are excluded).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,csproj,props,yml,yaml}]
indent_size = 2

[*.g.cs]
generated_code = true

[*.cs]
# One statement per line, braces on their own line (Allman), file-scoped namespaces.
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
max_line_length = 160
