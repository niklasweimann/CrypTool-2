<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed System.Drawing (the subset CT2 plugins use) for the browser: System.Drawing.Common only works on Windows. Pixel buffer + ImageSharp codecs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CrypWeb.Drawing</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>
</Project>
