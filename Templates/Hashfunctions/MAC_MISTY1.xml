  <title lang="en">CMAC with MISTY1</title>
  <summary lang="en"><i>CMAC with MISTY1</i></summary>
  <description lang="en">A message authentication code made of the block cipher MISTY1 (64-bit blocks).</description>
  <keywords lang="en">MAC, CMAC, MISTY1, authentication</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="With 64-bit blocks a MAC loses its security after about 2^32 messages with the same key." />
  </replacements>
  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
  <!--Language 'de' starts here:-->
