  <title lang="de">CMAC mit MISTY1</title>
  <summary lang="de"><i>CMAC mit MISTY1</i></summary>
  <description lang="de">Ein Nachrichtenauthentifizierungscode aus der Blockchiffre MISTY1 (64-Bit-Blöcke).</description>
  <keywords lang="en">MAC, CMAC, MISTY1, authentication</keywords>
  <replacements lang="de">
    <replacement key="$random number generator$" value="Zufallszahlengenerator" />
    <replacement key="$output$" value="Zufallsbytes" />
    <replacement key="$memo$" value="Bei 64-Bit-Blöcken verliert ein MAC nach etwa 2^32 Nachrichten mit demselben Schlüssel seine Sicherheit." />
  </replacements>
