  <title lang="en">Very Smooth Hash (VSH)</title>
  <summary lang="en"><i>Very Smooth Hash (VSH)</i></summary>
  <description lang="en">A hash function whose collision resistance is related to factoring.</description>
  <keywords lang="en">VSH, very smooth hash, hash function, factoring</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="Change the size of the modulus in the settings of the {\\b Very Smooth Hash} component: a larger modulus gives larger blocks." />
  </replacements>
  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
