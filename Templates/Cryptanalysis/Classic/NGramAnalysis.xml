  <title lang="en">N-gram Analysis</title>
  <summary lang="en"><i>N-gram Analysis</i></summary>
  <description lang="en">The most frequent bigrams of a text.</description>
  <keywords lang="en">n-gram, bigram, trigram, frequency, analysis</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="Change the length n of the n-grams in the settings of the {\\b Text Analysis} component: 1 gives letters, 3 gives trigrams." />
  </replacements>
