  <summary lang="en"><i>Hill Cipher: Known-Plaintext Attack</i></summary>
  <description lang="en">The 3 x 3 key matrix is calculated from known plaintext and ciphertext.</description>
  <keywords lang="en">Hill cipher, known plaintext, matrix, analysis</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
