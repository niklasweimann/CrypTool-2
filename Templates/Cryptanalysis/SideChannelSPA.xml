  <summary lang="de"><i>Seitenkanalangriff: SPA</i></summary>
  <description lang="de">Der geheime Exponent von Square-and-Multiply, gelesen aus einer einzigen simulierten Strommessung.</description>
  <keywords lang="en">side channel, SPA, power analysis, square and multiply, RSA</keywords>
  <replacements lang="de">
    <replacement key="$random number generator$" value="Zufallszahlengenerator" />
    <replacement key="$output$" value="Zufallsbytes" />
