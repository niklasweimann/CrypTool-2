  <title lang="en">Side-Channel Attack: SPA</title>
  <summary lang="en"><i>Side-Channel Attack: SPA</i></summary>
  <description lang="en">The secret exponent of square-and-multiply, read from a single simulated power trace.</description>
  <keywords lang="en">side channel, SPA, power analysis, square and multiply, RSA</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="Increase the noise in the settings of the {\\b Side-Channel Attacks} component until the trace can no longer be read." />
  </replacements>
  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
