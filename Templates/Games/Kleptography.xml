    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="The presentation shows the three steps with all numbers. Change the run in the settings of the {\\b Kleptography} component." />
  </replacements>
