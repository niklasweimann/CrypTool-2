  <title lang="en">Ant Colony Optimization</title>
  <summary lang="en"><i>Ant Colony Optimization</i></summary>
  <description lang="en">Ants search the shortest round trip through 12 cities.</description>
  <keywords lang="en">ant colony, ACO, travelling salesman, pheromone, heuristic</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="Press the buttons to let the ants walk. Change the number of cities, ants, the weights and the evaporation in the settings of the {\\b Ant Colony} component." />
  </replacements>
  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
