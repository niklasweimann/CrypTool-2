  <summary lang="de"><i>Ameisenalgorithmus</i></summary>
  <description lang="de">Ameisen suchen die kürzeste Rundreise durch 12 Städte.</description>
  <keywords lang="en">ant colony, ACO, travelling salesman, pheromone, heuristic</keywords>
  <replacements lang="de">
    <replacement key="$random number generator$" value="Zufallszahlengenerator" />
    <replacement key="$output$" value="Zufallsbytes" />
