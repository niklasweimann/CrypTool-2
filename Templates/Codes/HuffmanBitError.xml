  <title lang="de">Huffman-Codierung: Wirkung eines Bitfehlers</title>
  <summary lang="de"><i>Huffman-Codierung: Wirkung eines Bitfehlers</i></summary>
  <description lang="de">Ein Text im Huffman-Code mit einem gekippten Bit: Der Empfänger verliert die Stelle.</description>
  <keywords lang="en">Huffman, bit error, compression, error propagation</keywords>
  <replacements lang="de">
    <replacement key="$random number generator$" value="Zufallszahlengenerator" />
    <replacement key="$output$" value="Zufallsbytes" />
    <replacement key="$memo$" value="Ändern Sie die Position des Bitfehlers in den Einstellungen der Komponente {\\b Huffman-Codierung mit Fehlerkorrektur}." />
  </replacements>
