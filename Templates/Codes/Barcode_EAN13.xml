  <title lang="en">Barcode: EAN-13</title>
  <summary lang="en"><i>Barcode: EAN-13</i></summary>
  <description lang="en">The bars of an EAN-13 barcode; the check digit is added.</description>
  <keywords lang="en">barcode, EAN-13, EAN-8, check digit</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="Enter 12 digits; the thirteenth, the check digit, is calculated. Choose EAN-8 in the settings of the {\\b Barcode} component for the short code." />
  </replacements>
  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
  <!--Language 'de' starts here:-->
