  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
  <title lang="en">Zip and Unzip</title>
  <summary lang="en"><i>Zip and Unzip</i></summary>
  <description lang="en">The data is packed into a ZIP archive (deflate) and unpacked again.</description>
  <keywords lang="en">zip, unzip, compression, deflate</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="The first {\b Data Tools} component creates a ZIP archive from the text, the second reads the first entry of the archive. The text repeats itself, so it compresses well." />
  </replacements>
  <!--- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
  <!--Language 'de' starts here:-->
