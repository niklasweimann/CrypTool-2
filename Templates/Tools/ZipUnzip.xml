  <title lang="de">Zip und Unzip</title>
  <summary lang="de"><i>Zip und Unzip</i></summary>
  <description lang="de">Die Daten werden in ein ZIP-Archiv (Deflate) gepackt und wieder entpackt.</description>
  <keywords lang="en">zip, unzip, compression, deflate</keywords>
  <replacements lang="de">
    <replacement key="$random number generator$" value="Zufallszahlengenerator" />
    <replacement key="$output$" value="Zufallsbytes" />
    <replacement key="$memo$" value="Die erste Komponente {\b Datenwerkzeuge} erzeugt aus dem Text ein ZIP-Archiv, die zweite liest den ersten Eintrag des Archivs. Der Text wiederholt sich und lässt sich daher gut komprimieren." />
  </replacements>
