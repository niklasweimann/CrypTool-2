  <title lang="en">MISTY1</title>
  <summary lang="en"><i>MISTY1</i></summary>
  <description lang="en">The test vector of MISTY1: 0123456789ABCDEF is encrypted to 8B1DA5F56AB3D07C.</description>
  <keywords lang="en">MISTY1, KASUMI, block cipher, Matsui</keywords>
  <replacements lang="en">
    <replacement key="$random number generator$" value="RandomNumberGenerator" />
    <replacement key="$output$" value="Random bytes" />
    <replacement key="$memo$" value="MISTY1 has 64-bit blocks and 128-bit keys and is the basis of KASUMI." />
  </replacements>
