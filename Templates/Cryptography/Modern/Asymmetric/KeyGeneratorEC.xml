  <summary lang="de"><i>EC-Schlüsselpaar erzeugen (PEM)</i></summary>
  <description lang="de">Ein neues Schlüsselpaar auf der elliptischen Kurve P-256 als PEM-Blöcke.</description>
  <keywords lang="en">key generation, elliptic curve, EC, PEM, P-256</keywords>
  <replacements lang="de">
    <replacement key="$random number generator$" value="Zufallszahlengenerator" />
    <replacement key="$output$" value="Zufallsbytes" />
    <replacement key="$memo$" value="Wählen Sie in den Einstellungen der Komponente {\\b Schlüsselwerkzeug} eine andere Kurve." />
